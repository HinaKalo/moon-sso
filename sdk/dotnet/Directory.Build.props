<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>1.0.0</Version>
    <Authors>Moon SSO</Authors>
    <Company>Moon SSO</Company>
    <Copyright>Moon SSO</Copyright>
    <PackageProjectUrl>https://sso.moonl.cloud/docs</PackageProjectUrl>
    <PackageTags>oauth;oidc;openid-connect;sso;dpop;pkce;moon-sso</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageOutputPath>$(MSBuildThisFileDirectory)artifacts</PackageOutputPath>
    <Deterministic>true</Deterministic>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
  </PropertyGroup>
</Project>
