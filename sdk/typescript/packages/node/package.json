{
  "name": "@moon-sso/node",
  "version": "1.0.0",
  "description": "Moon SSO SDK for Node.js servers: confidential-client web login (BFF), session middleware, access-token verification, Standard Webhooks, back-channel logout, changes feed and dynamic client registration.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.js.map",
    "dist/**/*.d.ts.map",
    "src/**/*.ts",
    "README.md"
  ],
  "keywords": [
    "oauth2",
    "openid-connect",
    "bff",
    "webhooks",
    "backchannel-logout",
    "sso",
    "moon-sso"
  ],
  "engines": {
    "node": ">=20.10"
  }
}
