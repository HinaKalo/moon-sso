<?xml version="1.0" encoding="utf-8"?>
<!-- The Moon SSO session is encrypted with a device-bound Keystore key: never back it up or transfer it. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
